# Single-node Node runtime. Do not configure removed third-party integrations.
TZ=Asia/Shanghai
GROK2API_HOST=0.0.0.0
GROK2API_PORT=3000
GROK2API_DATA_DIR=/app/data-node
GROK2API_SQLITE_PATH=/app/data-node/app.sqlite

# Required before readiness and Chat/Responses traffic can be enabled. This is
# the direct xAI CLI Responses endpoint.
GROK2API_XAI_UPSTREAM_BASE_URL=https://cli-chat-proxy.grok.com/v1

GROK2API_ADMIN_USERNAME=admin
GROK2API_ADMIN_PASSWORD=nj@363600
GROK2API_REQUIRE_API_KEY=auto
GROK2API_DEFAULT_MODEL=grok-4.5
GROK2API_ACCOUNT_MODE=round_robin

GROK2API_AUTOMATION_WORKER=1
GROK2API_REAUTH_WORKERS=4
GROK2API_REGISTRATION_MAX_CONCURRENCY=3
GROK2API_TOKEN_MAINTAIN=1
GROK2API_TOKEN_MAINTAIN_INTERVAL=60
GROK2API_TOKEN_REFRESH_BATCH=20
GROK2API_TOKEN_REFRESH_WORKERS=2
GROK2API_TOKEN_REFRESH_SKEW=180
GROK2API_SSO_REAUTH_COOLDOWN=3600
GROK2API_USAGE_FLUSH_INTERVAL=15
GROK2API_USAGE_FLUSH_BATCH=100

# Cloudflare Temp Mail is the only registration mail provider.
GROK2API_CFMAIL_BASE_URL=https://replace-with-cloudflare-temp-mail-endpoint
GROK2API_CFMAIL_API_KEY=replace-me
GROK2API_CFMAIL_DOMAIN=replace-with-mail-domain

# Optional mature Python registration/captcha worker on loopback. Node retains
# task state, SSO conversion, and SQLite ownership.
GROK2API_REGISTRATION_SERVICE_URL=http://127.0.0.1:18070
GROK2API_REGISTRATION_TOKEN=replace-with-internal-token
GROK2API_REGISTRATION_TIMEOUT=600
